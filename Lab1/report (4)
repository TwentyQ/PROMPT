from gigachat import GigaChat
from gigachat.models import Chat, Messages, MessagesRole

with GigaChat(
    credentials="ВАШ_AUTHORIZATION_KEY",
    ca_bundle_file=r"ПУТЬ_К_СЕРТИФИКАТУ",
    model='gigachat-2-pro',
    scope='GIGACHAT_API_B2B') as giga:
  response=giga.chat(
      Chat(
          messages=[
              Messages(
                  role=MessagesRole.USER,
                  content="Как ты относишься к ИИ?"
              ),
              Messages(
                  role=MessagesRole.ASSISTANT,
                  content="Искусственный интеллект — мощный инструмент, открывающий перед человечеством новые горизонты возможностей и перспектив."
              ),
              Messages(
                  role=MessagesRole.USER,
                  content="Какие возможности он открывает?"
              )
          ]
      )
  )

print(response.choices[0].message.content)

